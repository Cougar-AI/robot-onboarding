<!--
  Flat 2-link arm (MuJoCo 3.x).  Robotic Arm Project Meeting, Simulation track.

  Both joints turn about world z, so everything happens in the x-y plane.
    j1  at the world origin            L1 = 0.40 m  (blue link)
    j2  at the elbow                   L2 = 0.30 m  (orange link)
    "elbow" site at the end of link 1, "hand" site at the tip of link 2.
  Zero pose: both links point along world +x.  Positive angles turn counterclockwise seen from above.
  MuJoCo stores joint angles in RADIANS: convert degrees first (np.deg2rad).

  Check: theta = (30 deg, 60 deg) -> hand = (0.346, 0.500) m
-->
<mujoco model="two_link_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002"/>

  <visual>
    <global offwidth="2400" offheight="1800" azimuth="120" elevation="-35"/>
    <quality shadowsize="8192" offsamples="8"/>
    <headlight ambient="0.36 0.36 0.36" diffuse="0.16 0.16 0.16" specular="0.05 0.05 0.05"/>
    <map znear="0.01" zfar="50" haze="0.6"/>
    <rgba haze="0.90 0.91 0.94 1"/>
  </visual>

  <statistic center="0.25 0.1 0" extent="0.9"/>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.97 0.98 1.0" rgb2="0.88 0.90 0.93" width="512" height="3072"/>
    <!-- checker: one square = 10 cm -->
    <texture name="checker" type="2d" builtin="checker" rgb1="0.87 0.88 0.90" rgb2="0.78 0.79 0.82" width="512" height="512"/>
    <material name="floor" texture="checker" texrepeat="5 5" texuniform="true" reflectance="0" specular="0.1" shininess="0.1"/>
    <material name="blue" rgba="0.18 0.44 0.84 1" specular="0.35" shininess="0.5"/>
    <material name="orange" rgba="0.85 0.44 0.10 1" specular="0.35" shininess="0.5"/>
    <material name="black" rgba="0.07 0.07 0.08 1" specular="0.3" shininess="0.6"/>
    <material name="gray" rgba="0.62 0.63 0.66 1" specular="0.3" shininess="0.4"/>
  </asset>

  <default>
    <joint damping="0.2" armature="0.005" range="-3.1 3.1"/>
    <geom contype="0" conaffinity="0" density="400"/>
    <position kp="20" dampratio="1" ctrlrange="-3.1 3.1"/>
  </default>

  <worldbody>
    <light name="key" directional="true" pos="0.6 -1.2 2.6" dir="-0.2 0.45 -1" diffuse="0.50 0.50 0.50" specular="0.25 0.25 0.25" castshadow="true"/>
    <light name="fill" directional="true" pos="-1.5 1.5 2.0" dir="0.6 -0.6 -1" diffuse="0.14 0.14 0.15" specular="0 0 0" castshadow="false"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <!-- fixed base at the world origin -->
    <geom name="base_disk" type="cylinder" size="0.07 0.008" pos="0 0 0.008" material="gray"/>

    <!-- links ride 4 cm above the floor -->
    <body name="link1" pos="0 0 0.04">
      <joint name="j1" axis="0 0 1"/>
      <geom name="j1_housing" type="cylinder" size="0.032 0.022" material="black"/>
      <geom name="link1" type="capsule" fromto="0 0 0  0.40 0 0" size="0.016" material="blue"/>

      <!-- elbow: L1 = 0.40 m -->
      <body name="link2" pos="0.40 0 0">
        <joint name="j2" axis="0 0 1"/>
        <geom name="j2_housing" type="cylinder" size="0.028 0.02" material="black"/>
        <geom name="link2" type="capsule" fromto="0 0 0  0.30 0 0" size="0.013" material="orange"/>
        <site name="elbow" pos="0 0 0" size="0.01" rgba="0 0 0 0"/>
        <!-- hand: L2 = 0.30 m past the elbow -->
        <site name="hand" pos="0.30 0 0" size="0.018" rgba="0.80 0.10 0.12 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="j1" joint="j1"/>
    <position name="j2" joint="j2"/>
  </actuator>

  <keyframe>
    <key name="zero" qpos="0 0" ctrl="0 0"/>
    <key name="deg_30_60" qpos="0.5235987756 1.0471975512" ctrl="0.5235987756 1.0471975512"/>
  </keyframe>
</mujoco>
